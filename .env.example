# Dominio del correo: solo se puede entrar con direcciones de aquí.
MAIL_DOMAIN=rud1.es

# Buzones (Dovecot). En producción, dentro de la red de Mailcow: IMAP_HOST=dovecot
IMAP_HOST=mail.rud1.es
IMAP_PORT=993

# Envío (Postfix, puerto de clientes con usuario y contraseña).
# En producción, dentro de la red de Mailcow: SMTP_HOST=postfix
SMTP_HOST=mail.rud1.es
SMTP_PORT=587

# Nombre del certificado TLS de los servidores de correo (cuando el host es interno).
MAIL_TLS_SERVERNAME=mail.rud1.es

# API de Mailcow: nombre y estado del buzón, contraseña provisional y cambio de contraseña.
# En desarrollo, a través de un túnel SSH:  ssh -L 8443:127.0.0.1:443 debian@mail.rud1.es
MAILCOW_API_URL=https://127.0.0.1:8443/api/v1
MAILCOW_API_KEY=
# Solo con el túnel de desarrollo (el certificado no es de 127.0.0.1).
MAILCOW_API_INSECURE_TLS=1

# Clave para cifrar la sesión (mínimo 32 caracteres):  openssl rand -base64 48
SESSION_SECRET=
