{
  "name": "rud1-mail-desktop",
  "version": "0.1.0",
  "description": "rud1 Mail",
  "main": "dist/main.js",
  "author": "rud1 <noreply@rud1.es>",
  "homepage": "https://mail.rud1.es",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "npm run build && cross-env RUD1_MAIL_URL=http://localhost:3100 electron .",
    "icons": "node scripts/generate-icons.mjs",
    "test": "npm run build && node --test dist/*.test.js",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "cross-env": "^7.0.3",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "es.rud1.mail",
    "productName": "rud1 Mail",
    "copyright": "Copyright © 2026 rud1",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*.js",
      "!dist/**/*.test.js",
      "assets/**/*",
      "package.json"
    ],
    "publish": null,
    "protocols": [
      {
        "name": "Correo electrónico",
        "schemes": [
          "mailto"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "rud1-Mail-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "rud1 Mail",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "rud1-Mail-${arch}.${ext}"
    },
    "dmg": {
      "title": "rud1 Mail"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "synopsis": "Correo de rud1",
      "maintainer": "rud1 <noreply@rud1.es>",
      "desktop": {
        "entry": {
          "StartupWMClass": "rud1 Mail"
        }
      },
      "artifactName": "rud1-Mail-${arch}.${ext}",
      "executableName": "rud1-mail"
    },
    "deb": {
      "artifactName": "rud1-mail_${version}_${arch}.${ext}"
    }
  }
}
